var_diff_x_tau_x = 16.0 + pow_2;

// ik1
IK1 = gK1 * (4.0 * (expm1(0.04 * (V + 85.0))) / (exp(0.08 * (V + 53.0)) + exp(0.04 * (V + 53.0))) + 0.2 * (V + 23.0) / (-expm1(-0.04 * (V + 23.0))));
gK1 = 0.35;

// ina
ENa = 50.0 + dot_sum * 1e-09;
INa = (gNa * pow(m, 3.0) * h * j + gNaC) * (V - ENa);
dot_h = dot_h_alpha * (1.0 - h) - dot_h_beta * h;
dot_h_alpha = 0.126 * exp(-0.25 * (V + 77.0));
dot_h_beta = 1.7 / (1.0 + exp(-0.082 * (V + 22.5)));
dot_j = dot_j_alpha * (1.0 - j) - dot_j_beta * j;
dot_j_alpha = 0.055 * exp(-0.25 * (V + 78.0)) / (1.0 + exp(-0.2 * (V + 78.0)));
