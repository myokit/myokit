dot_m = dot_m_alpha * (1.0 - m) - dot_m_beta * m;
dot_m_alpha = 1.0 * (V + 47.0) / (-expm1(-0.1 * (V + 47.0)));
dot_m_beta = 40.0 * exp(-0.056 * (V + 72.0));
dot_sum = dot_m + dot_h + dot_j;
gNa = 4.0;
gNaC = 0.003;
diff_h = dot_h;
diff_j = dot_j;
diff_m = dot_m;
m_start = 0.5 * m_full;
m_full = 1.0;

// is
Es = -82.3 - 13.0287 * log(Cai / 1000.0);
Is = gs * d * f * (V - Es);
alpha_d = 0.095 * exp(-0.01 * (V - 5.0)) / (1.0 + exp(-0.072 * (V - 5.0)));
beta_d = 0.07 * exp(-0.017 * (V + 44.0)) / (1.0 + exp(0.05 * (V + 44.0)));
alpha_f = 0.012 * exp(-0.008 * (V + 28.0)) / (1.0 + exp(0.15 * (V + 28.0)));
beta_f = pow_1_2 * exp(-0.02 * (V + 30.0)) / (1.0 + exp(-0.2 * (V + 30.0)));
gs = 0.09;
pow_1_2 = 0.0065;

// ix1
Ix1 = gx1 * x1 * (expm1(0.04 * (V + 77.0))) / exp(0.04 * (V + 35.0));
ix1_alpha_p1 = ix1_beta_p1;
ix1_beta_p1 = ix1_d_p1;
ix1_d_p1 = ix1_d_p1_tau_p1 + ix1_tau_p2;
ix1_d_p1_tau_p1 = 0.0003;
gx1 = 0.8;
ix1_tau_p2 = 0.0002;
alpha_x1 = ix1_alpha_p1 * exp(0.083 * (V + 50.0)) / (1.0 + exp(0.057 * (V + 50.0)));
beta_x1 = 0.0013 * exp(-0.06 * (V + 20.0)) / (1.0 + exp(-0.04 * (V + 20.0)));

// Sum of currents
Iion = IK1 + INa + Is + Ix1;

// Solve non-HH and non-Markov states with CVODE
group {
  m;
  h;
  j;
  Cai;
}.method(cvode);

