                  <cn cellml:units="mV">50.0</cn>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>ix1_x1_beta</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="mS_per_uF">0.0013</cn>
            <apply>
              <exp/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <cn cellml:units="per_mV">0.06</cn>
                </apply>
                <apply>
                  <plus/>
                  <ci>V</ci>
                  <cn cellml:units="mV">20.0</cn>
                </apply>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1.0</cn>
            <apply>
              <exp/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <cn cellml:units="per_mV">0.04</cn>
                </apply>
                <apply>
                  <plus/>
                  <ci>V</ci>
                  <cn cellml:units="mV">20.0</cn>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>x1</ci>
        </apply>
        <apply>
          <minus/>
          <apply>
            <times/>
            <ci>ix1_x1_alpha</ci>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1.0</cn>
              <ci>x1</ci>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>ix1_x1_beta</ci>
            <ci>x1</ci>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="membrane">
    <variable name="C" units="uF_per_cm2" initial_value="1.0"/>
    <variable name="IK1" units="uA_per_cm2" public_interface="in"/>
    <variable name="INa" units="uA_per_cm2" public_interface="in"/>
    <variable name="Is" units="uA_per_cm2" public_interface="in"/>
    <variable name="Ix1" units="uA_per_cm2" public_interface="in"/>
    <variable name="V" units="mV" public_interface="out" initial_value="-84.35"/>
    <variable name="i_diff" units="uA_per_cm2" initial_value="0.0"/>
    <variable name="i_ion" units="uA_per_cm2"/>
    <variable name="i_stim" units="uA_per_cm2" public_interface="in"/>
    <variable name="time" units="ms" public_interface="in"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>time</ci>
          </bvar>
          <ci>V</ci>
        </apply>
        <apply>
          <times/>
          <apply>
            <minus/>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">1.0</cn>
              <ci>C</ci>
            </apply>
          </apply>
          <apply>
            <plus/>
            <apply>
              <plus/>
              <ci>i_ion</ci>
              <ci>i_stim</ci>
            </apply>
            <ci>i_diff</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>i_ion</ci>
        <apply>
          <plus/>
          <apply>
            <plus/>
            <apply>
              <plus/>
              <ci>IK1</ci>
              <ci>Ix1</ci>
            </apply>
            <ci>INa</ci>
          </apply>
          <ci>Is</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="stimulus">
    <variable name="amplitude" units="uA_per_cm2" initial_value="-50.0" cmeta:id="amplitude"/>
    <variable name="duration" units="ms" initial_value="1.0" cmeta:id="duration"/>
    <variable name="i_stim" units="uA_per_cm2" public_interface="out"/>
    <variable name="offset" units="ms" initial_value="100.0" cmeta:id="offset"/>
    <variable name="period" units="ms" initial_value="1000.0" cmeta:id="period"/>
    <variable name="time" units="ms" public_interface="in"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>i_stim</ci>
        <apply>
          <times/>
          <piecewise>
            <piece>
              <cn cellml:units="dimensionless">1.0</cn>
              <apply>
                <lt/>
                <apply>
                  <minus/>
                  <apply>
                    <minus/>
                    <ci>time</ci>
                    <ci>offset</ci>
                  </apply>
                  <apply>
                    <times/>
                    <ci>period</ci>
                    <apply>
                      <floor/>
                      <apply>
                        <divide/>
                        <apply>
                          <minus/>
                          <ci>time</ci>
                          <ci>offset</ci>
                        </apply>
                        <ci>period</ci>
                      </apply>
                    </apply>
                  </apply>
                </apply>
                <ci>duration</ci>
              </apply>
            </piece>
            <otherwise>
              <cn cellml:units="dimensionless">0.0</cn>
            </otherwise>
          </piecewise>
          <ci>amplitude</ci>
        </apply>
      </apply>
    </math>
  </component>
